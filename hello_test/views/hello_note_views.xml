<odoo>
    <record id="hello_note_view_list" model="ir.ui.view">
        <field name="name">hello.note.list</field>
        <field name="model">hello.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="hello_note_view_form" model="ir.ui.view">
        <field name="name">hello.note.form</field>
        <field name="model">hello.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hello_note_action" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">hello.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hello_test_menu_root" name="Hello"/>
    <menuitem id="hello_note_menu" name="Notes" parent="hello_test_menu_root" action="hello_note_action"/>
</odoo>
