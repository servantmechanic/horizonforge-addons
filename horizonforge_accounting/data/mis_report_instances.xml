<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mis_instance_pl" model="mis.report.instance">
        <field name="name">Profit and Loss</field>
        <field name="report_id" ref="mis_report_pl"/>
        <!-- No company: reports on the company the user is working in. -->
        <field name="company_id" eval="False"/>
        <field name="comparison_mode" eval="True"/>
        <field name="landscape_pdf" eval="False"/>
    </record>
    <record id="mis_instance_pl_period_month" model="mis.report.instance.period">
        <field name="name">This Month</field>
        <field name="report_instance_id" ref="mis_instance_pl"/>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
        <field name="is_ytd" eval="False"/>
        <field name="sequence">10</field>
    </record>
