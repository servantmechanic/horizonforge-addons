<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_profit_loss" model="ir.actions.server">
        <field name="name">Profit and Loss</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance"/>
        <field name="state">code</field>
        <field name="code">action = env.ref("horizonforge_accounting.mis_instance_pl").preview()</field>
    </record>
    <menuitem id="menu_profit_loss" name="Profit and Loss" action="action_profit_loss"
              parent="account.account_reports_legal_statements_menu" sequence="10"
              groups="account.group_account_readonly"/>
    <record id="action_profit_loss_monthly" model="ir.actions.server">
        <field name="name">Profit and Loss by Month</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance"/>
        <field name="state">code</field>
        <field name="code">action = env.ref("horizonforge_accounting.mis_instance_pl_monthly").preview()</field>
    </record>
    <menuitem id="menu_profit_loss_monthly" name="Profit and Loss by Month" action="action_profit_loss_monthly"
              parent="account.account_reports_legal_statements_menu" sequence="11"
              groups="account.group_account_readonly"/>
    <record id="action_balance_sheet" model="ir.actions.server">
        <field name="name">Balance Sheet</field>
        <field name="model_id" ref="mis_builder.model_mis_report_instance"/>
        <field name="state">code</field>
        <field name="code">action = env.ref("horizonforge_accounting.mis_instance_bs").preview()</field>
    </record>
    <menuitem id="menu_balance_sheet" name="Balance Sheet" action="action_balance_sheet"
              parent="account.account_reports_legal_statements_menu" sequence="20"
              groups="account.group_account_readonly"/>
</odoo>
