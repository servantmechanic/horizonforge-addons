<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hf_qb_import_view_form" model="ir.ui.view">
        <field name="name">hf.qb.import.form</field>
        <field name="model">hf.qb.import</field>
        <field name="arch" type="xml">
            <form string="Import from QuickBooks Online">
                <field name="state" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div invisible="state != 'upload'">
                    <p>
                        In QuickBooks Online, run each report below as of the same date and
                        export it (Excel or CSV). Use the Accrual basis and show all accounts.
                    </p>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="cutover_date"/>
                            <field name="create_bank_journals"/>
                        </group>
                    </group>
                    <group string="Required">
                        <field name="account_list_file" filename="account_list_filename"/>
                        <field name="account_list_filename" invisible="1"/>
                        <field name="trial_balance_file" filename="trial_balance_filename"/>
                        <field name="trial_balance_filename" invisible="1"/>
                    </group>
                    <group string="Open Invoices and Bills">
                        <field name="ar_aging_file" filename="ar_aging_filename"/>
                        <field name="ar_aging_filename" invisible="1"/>
                        <field name="ap_aging_file" filename="ap_aging_filename"/>
                        <field name="ap_aging_filename" invisible="1"/>
                    </group>
                    <group string="Optional">
                        <field name="customers_file" filename="customers_filename"/>
                        <field name="customers_filename" invisible="1"/>
                        <field name="vendors_file" filename="vendors_filename"/>
                        <field name="vendors_filename" invisible="1"/>
                        <field name="pl_history_file" filename="pl_history_filename"/>
                        <field name="pl_history_filename" invisible="1"/>
                    </group>
                </div>
                <div invisible="state != 'map'">
                    <field name="summary" nolabel="1"/>
                    <p class="text-muted">
                        Check each account: use an existing Odoo account, or create one with the
                        code, name and type shown. Nothing is saved until you click Import.
                    </p>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="false" delete="false">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="qb_name"/>
                            <field name="qb_type"/>
                            <field name="qb_detail_type" optional="hide"/>
                            <field name="balance" sum="Total"/>
                            <field name="history_total" optional="hide"/>
                            <field name="action"/>
                            <field name="account_id" invisible="action != 'map'" required="action == 'map' and (balance or history_total)"/>
                            <field name="new_code" invisible="action != 'create'" required="action == 'create'"/>
                            <field name="new_name" invisible="action != 'create'" required="action == 'create'"/>
                            <field name="new_account_type" invisible="action != 'create'" required="action == 'create'"/>
                        </list>
                    </field>
                </div>
                <div invisible="state != 'done'">
                    <field name="result" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_analyze" type="object" string="Next" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="state != 'map'"
                            confirm="Create the accounts, contacts and posted opening entries now?"/>
                    <button name="action_back" type="object" string="Back" invisible="state != 'map'"/>
                    <button name="action_open_moves" type="object" string="View Entries" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button special="cancel" string="Close"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hf_qb_import" model="ir.actions.act_window">
        <field name="name">Import from QuickBooks</field>
        <field name="res_model">hf.qb.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hf_qb_import" name="Import from QuickBooks"
              parent="account.menu_finance_configuration" action="action_hf_qb_import"
              sequence="900" groups="account.group_account_manager"/>
</odoo>
