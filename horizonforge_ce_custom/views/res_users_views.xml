<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 hides Home Action; show it so users can choose their landing page. -->
    <record id="view_users_form_inherit_hf" model="ir.ui.view">
        <field name="name">res.users.form.inherit.horizonforge.ce.custom</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="action_id" options="{'no_create': True}"
                       placeholder="e.g. Discuss"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_inherit_hf" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.horizonforge.ce.custom</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="action_id" readonly="0" options="{'no_create': True}"
                       placeholder="e.g. Discuss"/>
            </xpath>
        </field>
    </record>
</odoo>
