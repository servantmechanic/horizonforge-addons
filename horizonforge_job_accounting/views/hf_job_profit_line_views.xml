<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hf_job_profit_line_view_list" model="ir.ui.view">
        <field name="name">hf.job.profit.line.list</field>
        <field name="model">hf.job.profit.line</field>
        <field name="arch" type="xml">
            <list string="Job Profitability" create="false" edit="false" delete="false"
                  action="action_open_source" type="object">
                <field name="date"/>
                <field name="project_id" context="{'hf_show_job_code': True}"/>
                <field name="category"/>
                <field name="name"/>
                <field name="employee_id" optional="show"/>
                <field name="general_account_id" optional="hide"/>
                <field name="move_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="hours" sum="Total" optional="show"/>
                <field name="revenue" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="burden" sum="Total" optional="hide"/>
                <field name="profit" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="hf_job_profit_line_view_pivot" model="ir.ui.view">
        <field name="name">hf.job.profit.line.pivot</field>
        <field name="model">hf.job.profit.line</field>
        <field name="arch" type="xml">
            <pivot string="Job Profitability" sample="1">
                <field name="project_id" type="row"/>
                <field name="revenue" type="measure"/>
                <field name="cost" type="measure"/>
                <field name="profit" type="measure"/>
                <field name="hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hf_job_profit_line_view_graph" model="ir.ui.view">
        <field name="name">hf.job.profit.line.graph</field>
        <field name="model">hf.job.profit.line</field>
        <field name="arch" type="xml">
            <graph string="Job Profitability" type="bar" sample="1">
                <field name="project_id"/>
                <field name="profit" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="hf_job_profit_line_view_search" model="ir.ui.view">
        <field name="name">hf.job.profit.line.search</field>
        <field name="model">hf.job.profit.line</field>
        <field name="arch" type="xml">
            <search string="Job Profitability">
                <field name="project_id" context="{'hf_show_job_code': True}"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="general_account_id"/>
                <filter name="revenue" string="Revenue" domain="[('category', '=', 'revenue')]"/>
                <filter name="labor" string="Labor" domain="[('category', '=', 'labor')]"/>
                <filter name="bills" string="Bills" domain="[('category', '=', 'bills')]"/>
                <filter name="other" string="Other Costs" domain="[('category', '=', 'other')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="groupby_project" string="Job" context="{'group_by': 'project_id'}"/>
                    <filter name="groupby_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="groupby_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="groupby_account" string="Account" context="{'group_by': 'general_account_id'}"/>
                    <filter name="groupby_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="groupby_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hf_job_profit_line" model="ir.actions.act_window">
        <field name="name">Job Costs and Revenue</field>
        <field name="res_model">hf.job.profit.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'hf_show_job_code': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No job revenue or costs yet</p>
            <p>Invoices, vendor bills and timesheets charged to a job show up here.</p>
        </field>
    </record>
</odoo>
