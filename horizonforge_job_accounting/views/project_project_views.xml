<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_hf_job_accounting" model="ir.ui.view">
        <field name="name">project.project.form.inherit.horizonforge.job.accounting</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_hf_job_profit_lines" type="object" class="oe_stat_button"
                        icon="fa-line-chart" invisible="is_template or not account_id"
                        groups="account.group_account_readonly,project.group_project_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="hf_profit" widget="monetary" options="{'currency_field': 'hf_currency_id'}" nolabel="1"/>
                        </span>
                        <span class="o_stat_text">Profit</span>
                    </div>
                    <field name="hf_currency_id" invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="project_project_view_list_hf_profitability" model="ir.ui.view">
        <field name="name">project.project.list.horizonforge.profitability</field>
        <field name="model">project.project</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Job Profitability" create="false" action="action_hf_job_profit_lines" type="object">
                <field name="hf_job_code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="last_update_status" widget="project_state_selection" optional="show"/>
                <field name="hf_currency_id" column_invisible="1"/>
                <field name="hf_contract_amount" sum="Total"/>
                <field name="hf_revenue" sum="Total"/>
                <field name="hf_to_invoice" sum="Total"/>
                <field name="hf_cost" sum="Total"/>
                <field name="hf_profit" sum="Total"/>
                <field name="hf_margin" widget="percentage"/>
                <field name="hf_hours" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_hf_job_profitability" model="ir.actions.act_window">
        <field name="name">Job Profitability</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project_project_view_list_hf_profitability"/>
        <field name="domain">[('is_template', '=', False), ('account_id', '!=', False)]</field>
        <field name="context">{'hf_show_job_code': True}</field>
        <field name="search_view_id" ref="project.view_project_project_filter"/>
    </record>

    <menuitem id="menu_hf_job_profitability" name="Job Profitability"
              parent="project.menu_project_report" action="action_hf_job_profitability"
              sequence="30" groups="account.group_account_readonly,project.group_project_manager"/>
    <menuitem id="menu_hf_job_profit_lines" name="Job Costs and Revenue"
              parent="project.menu_project_report" action="action_hf_job_profit_line"
              sequence="31" groups="account.group_account_readonly,project.group_project_manager"/>
    <menuitem id="menu_hf_job_profitability_accounting" name="Job Profitability"
              parent="account.account_reports_management_menu" action="action_hf_job_profitability"
              sequence="30" groups="account.group_account_readonly"/>
</odoo>
