<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_project" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.horizonforge.job.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="horizonforge_project_custom.res_config_settings_view_form_project"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='hf_payroll_setting_container']" position="inside">
                <setting id="hf_labor_burden" help="Added to wage cost in Job Profitability: payroll taxes, workers' comp, benefits">
                    <field name="hf_labor_burden_pct"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
