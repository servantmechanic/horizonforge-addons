<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_timesheet_payroll">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="data" t-value="doc._get_report_data()"/>
                    <t t-set="money" t-value="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                    <div class="page small">
                        <h4>Timesheet Payroll</h4>
                        <p>
                            <span t-out="data['date_from']"/> to <span t-out="data['date_to']"/>.
                            Overtime at <span t-out="'%.2f' % data['ot_multiplier']"/>x
                            over <span t-out="'%.2f' % data['ot_threshold']"/> hours per week.
                        </p>
                        <p t-if="not data['rows']">No timesheets in this period.</p>
                        <t t-foreach="data['weeks']" t-as="week">
                            <h5 class="mt-3">Week of <span t-out="week"/></h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Project</th>
                                        <th class="text-end">Hours</th>
                                        <th class="text-end">Regular</th>
                                        <th class="text-end">Overtime</th>
                                        <th class="text-end">Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="[row for row in data['rows'] if row['week_start'] == week]" t-as="row">
                                        <tr t-foreach="row['projects']" t-as="line">
                                            <td t-out="row['employee'].name"/>
                                            <td t-out="line['project'].display_name"/>
                                            <td class="text-end" t-out="'%.2f' % line['hours']"/>
                                            <td/>
                                            <td/>
                                            <td/>
                                        </tr>
                                        <tr class="fw-bold">
                                            <td t-out="row['employee'].name"/>
                                            <td>
                                                Total
                                                <span t-if="row['missing_wage']" class="text-danger">(no wage set)</span>
                                            </td>
                                            <td class="text-end" t-out="'%.2f' % row['total']"/>
                                            <td class="text-end" t-out="'%.2f' % row['regular']"/>
                                            <td class="text-end" t-out="'%.2f' % row['overtime']"/>
                                            <td class="text-end"><span t-out="row['cost']" t-options="money"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <p t-if="data['rows']" class="fw-bold">
                            Total: <span t-out="'%.2f' % data['total_hours']"/> hours,
                            <span t-out="'%.2f' % data['total_overtime']"/> overtime,
                            <span t-out="data['total_cost']" t-options="money"/>
                        </p>
                        <t t-if="data['job_lines']">
                            <h5 class="mt-3">Job Cost</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Job Code</th>
                                        <th>Project</th>
                                        <th>Task</th>
                                        <th class="text-end">Hours</th>
                                        <th class="text-end">Labor Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data['job_lines']" t-as="line">
                                        <td t-out="line['project'].hf_job_code or ''"/>
                                        <td t-out="line['project'].display_name"/>
                                        <td t-out="line['task'].display_name or ''"/>
                                        <td class="text-end" t-out="'%.2f' % line['hours']"/>
                                        <td class="text-end"><span t-out="line['cost']" t-options="money"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
