<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_course_view_list" model="ir.ui.view">
        <field name="name">school.course.view.list</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="grade_level_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="teacher_id" widget="many2one_avatar" options="{'no_create': True}" optional="show"/>
            </list>
        </field>
    </record>

    <record id="school_course_view_search" model="ir.ui.view">
        <field name="name">school.course.view.search</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="grade_level_ids"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="school_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a course</p>
            <p>A course is a subject for one group, such as Math 5. Each year it is taught as a class.</p>
        </field>
    </record>
</odoo>
