<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_enrollment_view_list" model="ir.ui.view">
        <field name="name">school.enrollment.view.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="student_id" options="{'no_create': True}"/>
                <field name="section_id" options="{'no_create': True}"/>
                <field name="teacher_id" widget="many2one_avatar" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="school_enrollment_view_search" model="ir.ui.view">
        <field name="name">school.enrollment.view.search</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="course_id"/>
                <filter name="my_classes" string="My Classes"
                        domain="['|', '|', ('section_id.teacher_id', '=', uid), ('section_id.co_teacher_ids', 'in', uid), ('section_id.enrollment_ids.student_id.homeroom_id.teacher_id', '=', uid)]"/>
                <separator/>
                <filter name="current_year" string="Current Year" domain="[('year_id.is_current', '=', True)]"/>
                <group>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                    <filter name="group_section" string="Class" context="{'group_by': 'section_id'}"/>
                    <filter name="group_course" string="Course" context="{'group_by': 'course_id'}"/>
                    <filter name="group_year" string="School Year" context="{'group_by': 'year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="school_enrollment_action" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>
</odoo>
