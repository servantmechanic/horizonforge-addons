<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_document_upload_view_form" model="ir.ui.view">
        <field name="name">school.document.upload.view.form</field>
        <field name="model">school.document.upload</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="folder_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="attachment_ids" widget="many2many_binary" string="Files"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="school_document_upload_action" model="ir.actions.act_window">
        <field name="name">Upload Files</field>
        <field name="res_model">school.document.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
