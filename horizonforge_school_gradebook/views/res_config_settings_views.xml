<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.school.gradebook</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="horizonforge_school_core.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="school_preferences_setting_container" position="inside">
                <setting string="Gradebook: Enter Moves" company_dependent="1"
                         help="Where Enter goes after a score, for new users. Each teacher can change it in My Preferences or in the gradebook.">
                    <field name="school_enter_direction" widget="radio"/>
                </setting>
                <setting string="Gradebook: Tab Adds an Assignment" company_dependent="1"
                         help="Tab past the last column, after scoring it, adds the next assignment (as in Candle), for new users.">
                    <field name="school_tab_adds_column"/>
                </setting>
                <setting string="Gradebook: Letter in Every Cell" company_dependent="1"
                         help="Show the letter beside every score, for new users. Scores typed as letters always show their percent beside them.">
                    <field name="school_cell_letters"/>
                </setting>
            </block>
            <block name="school_report_setting_container" position="before">
                <block title="Gradebook" name="school_gradebook_setting_container">
                    <setting string="Entry Mode" company_dependent="1"
                             help="What teachers type: a percent, the points earned, or the number wrong. A class or an assignment can use another mode.">
                        <field name="school_entry_mode"/>
                    </setting>
                    <setting string="Weight Scheme" company_dependent="1"
                             help="How much each score category counts. A course or a class can have its own.">
                        <field name="school_weight_scheme_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Grading Scale" company_dependent="1"
                             help="Turns a percent into a letter. A grade level or a course can have its own.">
                        <field name="school_grading_scale_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Missing Work" company_dependent="1"
                             help="How a score marked missing (M) counts in the averages.">
                        <field name="school_missing_work" widget="radio"/>
                    </setting>
                    <setting string="Year Grade" company_dependent="1"
                             help="How the year grade is made from the grading periods.">
                        <field name="school_year_grade" widget="radio"/>
                    </setting>
                    <setting string="Rounding" company_dependent="1"
                             help="Grades are rounded half up (92.5 becomes 93 with 0 decimals) before the letter is looked up.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="school_grade_decimals" string="Grade decimals" class="col-lg-5 o_light_label"/>
                                <field name="school_grade_decimals" class="col-lg-2"/>
                            </div>
                            <div class="row">
                                <label for="school_display_decimals" string="Average decimals" class="col-lg-5 o_light_label"/>
                                <field name="school_display_decimals" class="col-lg-2"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
            <block name="school_report_setting_container" position="inside">
                <setting string="Report Card Cover" company_dependent="1"
                         help="The verse or motto and the letter to parents on the cover. The school name and logo come from the company.">
                    <div class="content-group">
                        <div class="mt8">
                            <label for="school_card_motto" string="Verse or motto" class="o_light_label"/>
                            <field name="school_card_motto" placeholder="e.g. a verse and its reference"/>
                        </div>
                        <div class="mt8">
                            <label for="school_card_letter" string="Letter to parents" class="o_light_label"/>
                            <field name="school_card_letter"/>
                        </div>
                        <div class="mt8">
                            <label for="school_card_letter_signature" string="Signed by" class="o_light_label"/>
                            <field name="school_card_letter_signature"/>
                        </div>
                    </div>
                </setting>
                <setting string="Conduct Grades" company_dependent="1"
                         help="Printed on the report card with empty boxes for each grading period, for the teacher to fill in by hand. One line each: a heading, then its traits starting with a dash.">
                    <field name="school_conduct_traits"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
