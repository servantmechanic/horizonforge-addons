<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_assignment_view_list" model="ir.ui.view">
        <field name="name">school.assignment.view.list</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="date desc, sequence">
                <field name="year_id" column_invisible="1"/>
                <field name="section_id" options="{'no_create': True}"/>
                <field name="date"/>
                <field name="name"/>
                <field name="category_id" options="{'no_create': True}"/>
                <field name="max_points"/>
                <field name="entry_mode"/>
                <field name="period_id" options="{'no_create': True}" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Also the grid's quick form (Ctrl+Shift+A, or a click on a column header). -->
    <record id="school_assignment_view_form" model="ir.ui.view">
        <field name="name">school.assignment.view.form</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="year_id" invisible="1"/>
                            <field name="course_id" invisible="1"/>
                            <field name="template_id" string="From Schedule" placeholder="None: type the details"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="name" placeholder="e.g. Lesson 12" default_focus="1"/>
                            <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="max_points"/>
                            <field name="entry_mode"/>
                            <field name="section_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="id" invisible="context.get('school_gradebook_dialog')"/>
                            <field name="period_id" options="{'no_create': True, 'no_open': True}"
                                   invisible="context.get('school_gradebook_dialog')"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="school_assignment_view_search" model="ir.ui.view">
        <field name="name">school.assignment.view.search</field>
        <field name="model">school.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="section_id"/>
                <field name="category_id"/>
                <field name="period_id"/>
                <filter name="current_year" string="Current Year" domain="[('section_id.year_id.is_current', '=', True)]"/>
                <filter name="my_classes" string="My Classes"
                        domain="['|', ('section_id.teacher_id', '=', uid), ('section_id.co_teacher_ids', 'in', uid)]"/>
                <group>
                    <filter name="group_section" string="Class" context="{'group_by': 'section_id'}"/>
                    <filter name="group_period" string="Grading Period" context="{'group_by': 'period_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="school_assignment_action" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">school.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_year': 1, 'search_default_group_section': 1}</field>
    </record>

    <record id="school_gradebook_action" model="ir.actions.client">
        <field name="name">Gradebook</field>
        <field name="tag">school_gradebook_grid</field>
    </record>
</odoo>
