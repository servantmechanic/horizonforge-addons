<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_score_category_view_list" model="ir.ui.view">
        <field name="name">school.score.category.view.list</field>
        <field name="model">school.score.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color"/>
            </list>
        </field>
    </record>

    <record id="school_score_category_action" model="ir.actions.act_window">
        <field name="name">Score Categories</field>
        <field name="res_model">school.score.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
