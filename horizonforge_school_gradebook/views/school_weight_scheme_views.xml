<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_weight_scheme_view_list" model="ir.ui.view">
        <field name="name">school.weight.scheme.view.list</field>
        <field name="model">school.weight.scheme</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="method"/>
            </list>
        </field>
    </record>

    <record id="school_weight_scheme_view_form" model="ir.ui.view">
        <field name="name">school.weight.scheme.view.form</field>
        <field name="model">school.weight.scheme</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="method" widget="radio"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="weight" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="school_weight_scheme_action" model="ir.actions.act_window">
        <field name="name">Weight Schemes</field>
        <field name="res_model">school.weight.scheme</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
