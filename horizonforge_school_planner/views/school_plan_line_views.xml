<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_plan_line_view_calendar" model="ir.ui.view">
        <field name="name">school.plan.line.view.calendar</field>
        <field name="model">school.plan.line</field>
        <field name="arch" type="xml">
            <calendar string="Planner" js_class="school_planner_calendar" date_start="date" date_stop="date_end" color="section_id"
                      mode="month" quick_create="0" create="0" delete="0" event_open_popup="1">
                <field name="section_id" filters="1"/>
                <field name="class_order" invisible="1"/>
                <field name="topic" invisible="not topic"/>
                <field name="done"/>
                <field name="note" invisible="not note"/>
            </calendar>
        </field>
    </record>

    <record id="school_plan_line_view_list" model="ir.ui.view">
        <field name="name">school.plan.line.view.list</field>
        <field name="model">school.plan.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0" default_order="class_order, sequence"
                  decoration-muted="done" decoration-warning="not date">
                <header>
                    <button name="action_weekly_plan" type="object" string="Weekly Plan" display="always"
                            icon="fa-print"/>
                </header>
                <field name="section_id" readonly="1" optional="show"/>
                <field name="unit" optional="hide"/>
                <field name="name" readonly="1"/>
                <field name="topic" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="date" readonly="done" placeholder="Doesn't fit"/>
                <field name="done" widget="boolean" readonly="1" optional="show"/>
                <field name="pinned" readonly="1" optional="show"/>
                <button name="action_unpin" type="object" icon="fa-unlock" title="Let the plan place it again"
                        invisible="not pinned"/>
                <field name="note" optional="show" placeholder="Note for the day"/>
                <field name="assignment_id" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- The calendar's popup. -->
    <record id="school_plan_line_view_form" model="ir.ui.view">
        <field name="name">school.plan.line.view.form</field>
        <field name="model">school.plan.line</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="section_id" readonly="1"/>
                            <field name="item_id" readonly="1"/>
                            <field name="unit" invisible="not unit"/>
                            <field name="category_id" invisible="not category_id"/>
                        </group>
                        <group>
                            <field name="date" readonly="done"/>
                            <field name="date_end" readonly="1" invisible="date_end == date"/>
                            <field name="done" readonly="1"/>
                            <field name="pinned" readonly="1" invisible="not pinned"/>
                            <field name="assignment_id" readonly="1" invisible="not assignment_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note for the day, for example Bring rulers"/>
                    <field name="item_note" readonly="1" invisible="not item_note"/>
                </sheet>
                <footer invisible="not pinned">
                    <button name="action_unpin" type="object" string="Let the Plan Place It"
                            help="Clear the date set by hand"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="school_plan_line_view_search" model="ir.ui.view">
        <field name="name">school.plan.line.view.search</field>
        <field name="model">school.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="topic"/>
                <field name="section_id"/>
                <field name="course_id"/>
                <filter name="my_classes" string="My Classes"
                        domain="['|', ('section_id.teacher_id', '=', uid), ('section_id.co_teacher_ids', 'in', uid)]"/>
                <separator/>
                <filter name="current_year" string="Current Year" domain="[('year_id.is_current', '=', True)]"/>
                <separator/>
                <filter name="to_teach" string="Not Completed" domain="[('done', '=', False)]"/>
                <filter name="taught" string="Completed" domain="[('done', '=', True)]"/>
                <filter name="pinned" string="Dates Set by Hand" domain="[('pinned', '=', True)]"/>
                <filter name="no_date" string="Doesn't Fit the Year" domain="[('date', '=', False)]"/>
                <group>
                    <filter name="group_section" string="Class" context="{'group_by': 'section_id'}"/>
                    <filter name="group_unit" string="Unit" context="{'group_by': 'unit'}"/>
                </group>
                <!-- The list, one class at a time: its lessons in order, to drag. -->
                <searchpanel view_types="list">
                    <field name="section_id" string="Class" icon="fa-graduation-cap"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="school_plan_line_action" model="ir.actions.act_window">
        <field name="name">Planner</field>
        <field name="res_model">school.plan.line</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing planned yet</p>
            <p>The planner lays each course's pacing guide over its class's days.
               Build a guide under Planner, Pacing Guides.</p>
        </field>
    </record>

    <record id="school_plan_line_server_action" model="ir.actions.server">
        <field name="name">Planner</field>
        <field name="model_id" ref="model_school_plan_line"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_planner()</field>
    </record>
</odoo>
