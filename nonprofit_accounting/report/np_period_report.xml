<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_np_compact" model="report.paperformat">
        <field name="name">Nonprofit Letter Compact</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_period" model="ir.actions.report">
        <field name="name">Period Report</field>
        <field name="model">np.period.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nonprofit_accounting.report_period</field>
        <field name="report_file">nonprofit_accounting.report_period</field>
        <field name="paperformat_id" ref="paperformat_np_compact"/>
        <field name="print_report_name">'Period Report - %s to %s' % (object.date_from, object.date_to)</field>
    </record>

    <record id="action_report_period_html" model="ir.actions.report">
        <field name="name">Period Report</field>
        <field name="model">np.period.report</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">nonprofit_accounting.report_period</field>
        <field name="report_file">nonprofit_accounting.report_period</field>
    </record>
</odoo>
