<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="np_move_line_view_pivot" model="ir.ui.view">
        <field name="name">np.move.line.pivot</field>
        <field name="model">np.move.line</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="account_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="report_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="np_move_line_view_graph" model="ir.ui.view">
        <field name="name">np.move.line.graph</field>
        <field name="model">np.move.line</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="1" sample="1">
                <field name="date" interval="month"/>
                <field name="account_id"/>
                <field name="report_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="np_move_line_view_list_report" model="ir.ui.view">
        <field name="name">np.move.line.list.report</field>
        <field name="model">np.move.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" action="action_open_move" type="object">
                <field name="date"/>
                <field name="move_id"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="report_amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="np_move_line_drilldown_action" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">np.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="np_move_line_view_list_report"/>
        <field name="search_view_id" ref="np_move_line_view_search"/>
    </record>

    <record id="np_income_report_action" model="ir.actions.act_window">
        <field name="name">Income Analysis</field>
        <field name="res_model">np.move.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('account_type', '=', 'income'), ('state', '=', 'posted')]</field>
        <field name="context">{'pivot_row_groupby': ['account_id', 'partner_id']}</field>
        <field name="search_view_id" ref="np_move_line_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No income posted yet</p>
            <p>Income from posted deposits appears here, by account, source and month.</p>
        </field>
    </record>

    <record id="np_expense_report_action" model="ir.actions.act_window">
        <field name="name">Expense Analysis</field>
        <field name="res_model">np.move.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('account_type', '=', 'expense'), ('state', '=', 'posted')]</field>
        <field name="context">{'pivot_row_groupby': ['account_id']}</field>
        <field name="search_view_id" ref="np_move_line_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No expenses posted yet</p>
            <p>Expenses from posted payments appear here, by account and month.</p>
        </field>
    </record>

    <!-- Use the report list (positive amounts) in the analysis actions. -->
    <record id="np_income_report_action_list" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="np_move_line_view_list_report"/>
        <field name="act_window_id" ref="np_income_report_action"/>
    </record>
    <record id="np_expense_report_action_list" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="np_move_line_view_list_report"/>
        <field name="act_window_id" ref="np_expense_report_action"/>
    </record>
</odoo>
