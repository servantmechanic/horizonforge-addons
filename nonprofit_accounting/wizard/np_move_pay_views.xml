<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="np_move_pay_view_form" model="ir.ui.view">
        <field name="name">np.move.pay.form</field>
        <field name="model">np.move.pay</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="move_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_total" string="Amount"/>
                        <field name="paid_date"/>
                    </group>
                    <group>
                        <field name="bank_account_id" options="{'no_create': True}"/>
                        <field name="check_number"/>
                    </group>
                </group>
                <footer>
                    <button name="action_pay" string="Pay" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
