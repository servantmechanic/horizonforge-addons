<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="np_period_report_view_form" model="ir.ui.view">
        <field name="name">np.period.report.form</field>
        <field name="model">np.period.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="date_from" string="From"/>
                        <field name="date_to" string="To"/>
                    </group>
                    <group>
                        <field name="bank_account_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All bank and cash accounts"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view" string="View" type="object" class="btn-primary"/>
                    <button name="action_print" string="Print PDF" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="np_period_report_action" model="ir.actions.act_window">
        <field name="name">Period Report</field>
        <field name="res_model">np.period.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
